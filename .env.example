# External REST API base URL (used when NEXT_PUBLIC_USE_MOCK_API=false)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Toggle the in-browser mock adapter vs a real REST API
NEXT_PUBLIC_USE_MOCK_API=true

# Feature flags
# Student portal is fully built but hidden by default
NEXT_PUBLIC_ENABLE_STUDENT_PORTAL=false

# Future backend-pending modules (fees, homework, leave, library loans, transport)
NEXT_PUBLIC_ENABLE_FUTURE_MODULES=false

# Google Maps Platform API key (restrict to HTTP referrers)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
